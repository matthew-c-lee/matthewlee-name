# Server-side scripts only. Never use NEXT_PUBLIC_ for these values.
EXAROTON_API_TOKEN=
EXAROTON_SERVER_ID=
EXAROTON_WORLD_PATH=world
# Optional relative region directory; empty auto-detects classic and Minecraft 26.1+ layouts.
EXAROTON_REGION_PATH=

# Fallback: an offline world folder or downloaded .zip, containing level.dat and region/.
# With credentials set, the script also requires the remote server to be offline.
BLUEMAP_WORLD_SOURCE=

# Optional local tools. CI installs the compatible Java runtime.
# JAVA_HOME=/absolute/path/to/jdk-25
# PYTHON=python3
# BLUEMAP_MINECRAFT_VERSION=1.21.4

# Empty for matthewlee.name; /repository-name when testing repository Pages hosting.
PAGES_BASE_PATH=
